<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HealthComm.PractitionerRegistrationPage"
             Title="Practitioner Registration">
    <VerticalStackLayout>
        <Label Text="Practitioner Registration" />
        <Entry x:Name="PractitionerFirstNameEntry" Placeholder="Enter practitioner first name" />
        <Entry x:Name="PractitionerLastNameEntry" Placeholder="Enter practitioner last name" />
        <Entry x:Name="PractitionerSpecialty" Placeholder="Enter practitioner specialty" />
    </VerticalStackLayout>
</ContentPage>