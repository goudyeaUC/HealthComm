<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HealthComm.PractitionerRegistrationPage"
             Title="Practitioner Registration">
    <VerticalStackLayout>
        <Label Text="Practitioner Registration" />
        <Label Text="First Name" />
        <Entry x:Name="PractitionerFirstNameEntry" Placeholder="Enter first name" />
        <Label Text="Last Name" />
        <Entry x:Name="PractitionerLastNameEntry" Placeholder="Enter last name" />
        <Label Text="Specialty" />
        <Entry x:Name="PractitionerSpecialty" Placeholder="Enter specialty" />
        <Label Text="Email" />
        <Entry x:Name="PractitionerEmailEntry" Placeholder="Enter email address" />
        <Label Text="Phone Number" />
        <Entry x:Name="PractitionerPhoneEntry" Placeholder="Enter phone number" />

    </VerticalStackLayout>
</ContentPage>