<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HealthComm.HealthCommHomePage"
             Title="HealthCommHomePage">
    <Frame
Grid.Row="2"
Padding="20"
Margin="10"
CornerRadius="15"
BorderColor="LightGray"
HorizontalOptions="Fill"
VerticalOptions="Start">

        <VerticalStackLayout Spacing="20">

            <!-- Login and Registration group -->
            <Grid ColumnSpacing="20">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Login group -->
                <Frame
            Grid.Column="0"
            Padding="15"
            CornerRadius="10"
            BorderColor="LightGray"
            HorizontalOptions="Fill">

                    <VerticalStackLayout
                Spacing="15"
                VerticalOptions="Center">

                        <Label
                    Text="Login"
                    FontSize="20"
                    FontAttributes="Bold"
                    HorizontalOptions="Center" />

                        <Button
                    Text="Login"
                    HeightRequest="50"
                    CornerRadius="10"
                    Clicked="LoginButton_Clicked" />

                    </VerticalStackLayout>
                </Frame>

                <!-- Registration group -->
                <Frame
            Grid.Column="1"
            Padding="15"
            CornerRadius="10"
            BorderColor="LightGray"
            HorizontalOptions="Fill">

                    <VerticalStackLayout Spacing="15">

                        <Label
                    Text="Registration"
                    FontSize="20"
                    FontAttributes="Bold"
                    HorizontalOptions="Center" />

                        <Button
                    Text="Register Patient"
                    HeightRequest="50"
                    CornerRadius="10"
                    Clicked="RegisterPatientButton_Clicked" />

                        <Button
                    Text="Register Practitioner"
                    HeightRequest="50"
                    CornerRadius="10"
                    Clicked="RegisterPractitionerButton_Clicked" />

                    </VerticalStackLayout>
                </Frame>

            </Grid>

            <!-- Additional buttons across the bottom -->
            <Grid ColumnSpacing="20">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button
            Grid.Column="0"
            Text="Practitioner Wait Time"
            HeightRequest="55"
            CornerRadius="10"
            HorizontalOptions="Fill"
            Clicked="PractitionerWaitTimeButton_Clicked" />

                <Button
            Grid.Column="1"
            Text="Appointment Manager"
            HeightRequest="55"
            CornerRadius="10"
            HorizontalOptions="Fill"
            Clicked="AppointmentManagerButton_Clicked" />

                <Button
            Grid.Column="2"
            Text="Practitioner Patient Assignment UI"
            HeightRequest="55"
            CornerRadius="10"
            HorizontalOptions="Fill"
            Clicked="PractitionerPatientAssignmentUIButton_Clicked" />

            </Grid>

        </VerticalStackLayout>
    </Frame>

</ContentPage>