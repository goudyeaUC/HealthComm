<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HealthComm.MedicalConditionPage"
             Title="MedicalConditionPage">
    <Grid Padding="20"
          RowDefinitions="Auto,Auto,*"
          RowSpacing="12">

        <!-- Page heading -->
        <VerticalStackLayout Grid.Row="0" Spacing="4">
            <Label
                Text="Medical Conditions"
                FontSize="26"
                FontAttributes="Bold"
                TextColor="#183153" />

            <Label
                Text="View Patient medical conditions."
                FontSize="14"
                TextColor="#667085" />
        </VerticalStackLayout>

        <!-- Loading indicator and error message -->
        <VerticalStackLayout Grid.Row="1" Spacing="6">

            <ActivityIndicator
                x:Name="LoadingIndicator"
                IsRunning="False"
                IsVisible="False"
                Color="#2878B5" />

            <Label
                x:Name="ErrorLabel"
                IsVisible="False"
                TextColor="#C0392B"
                FontSize="13" />

        </VerticalStackLayout>

        <!-- Scrollable medical conditions list -->
        <CollectionView
            Grid.Row="2"
            x:Name="ConditionList"
            ItemsSource="{Binding MedicalConditions}"
            SelectionMode="Single"
            VerticalOptions="Fill"
            VerticalScrollBarVisibility="Always">

            <CollectionView.EmptyView>
                <VerticalStackLayout
                    Padding="20"
                    Spacing="8"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">

                    <Label
                        Text="No medical conditions found."
                        FontSize="16"
                        TextColor="#667085"
                        HorizontalTextAlignment="Center" />

                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Border
                        Padding="14"
                        Margin="0,4"
                        Stroke="#D9E1EA"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        BackgroundColor="White">

                        <VerticalStackLayout Spacing="8">

                            <!-- Condition name -->
                            <Label
                                Text="{Binding ConditionName}"
                                FontSize="19"
                                FontAttributes="Bold"
                                TextColor="#183153" />

                            <!-- Condition ID -->
                            <Label
                                Text="{Binding ConditionId,
                                    StringFormat='Condition ID: {0}'}"
                                FontSize="13"
                                TextColor="#475467" />

                            <!-- Patient ID -->
                            <Label
                                Text="{Binding PatientId,
                                    StringFormat='Patient ID: {0}'}"
                                FontSize="13"
                                TextColor="#475467" />

                            <!-- Category -->
                            <Label
                                Text="{Binding Category,
                                    StringFormat='Category: {0}'}"
                                FontSize="13"
                                TextColor="#475467" />

                            <!-- Clinical status -->
                            <Label
                                Text="{Binding ClinicalStatus,
                                    StringFormat='Clinical Status: {0}'}"
                                FontSize="13"
                                TextColor="#475467" />

                        </VerticalStackLayout>

                    </Border>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>
</ContentPage>