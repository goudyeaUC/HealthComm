<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HealthComm.MainPage">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Welcome -->
            <Frame>
                <VerticalStackLayout>
                    <Label Text="Good Morning, John"
                   FontSize="24"
                   FontAttributes="Bold"/>
                    <Label Text="Next Appointment: Oct 15, 2026 @ 10:30 AM"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Wait Time -->
            <Frame>
                <VerticalStackLayout>
                    <Label Text="Average Clinic Wait Time"
                   FontAttributes="Bold"/>
                    <Label Text="22 Minutes"
                   FontSize="32"
                   TextColor="Green"/>
                    <Label Text="Delay reported in Laboratory Department"/>
                    <Button Text="View Live Updates"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Prescriptions -->
            <Frame>
                <VerticalStackLayout>
                    <Label Text="My Prescriptions"
                   FontAttributes="Bold"/>

                    <CollectionView ItemsSource="{Binding Prescriptions}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame Margin="0,5">
                                    <VerticalStackLayout>
                                        <Label Text="{Binding DrugName}"/>
                                        <Label Text="{Binding Dosage}"/>
                                        <HorizontalStackLayout>
                                            <Button Text="Drug Facts"/>
                                            <Button Text="Call Refill"/>
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>

            <!-- Calendar -->
            <Frame>
                <VerticalStackLayout>
                    <Label Text="Upcoming Visits"
                   FontAttributes="Bold"/>

                    <CollectionView ItemsSource="{Binding Appointments}" />

                    <Button Text="Schedule New Visit"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Quick Question -->
            <Frame>
                <VerticalStackLayout>
                    <Label Text="Ask a Quick Question"/>
                    <Editor Placeholder="Enter your question..." />
                    <Button Text="Send"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Notifications -->
            <Frame>
                <VerticalStackLayout>
                    <Label Text="Notification Settings"
                   FontAttributes="Bold"/>

                    <CheckBox/>
                    <Label Text="Notify on every status change"/>

                    <CheckBox/>
                    <Label Text="Notify when less than 30 mins remain"/>

                    <CheckBox/>
                    <Label Text="Notify 15 mins before appointment"/>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
