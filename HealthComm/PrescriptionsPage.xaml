<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:HealthComm.ViewModels"
             x:Class="HealthComm.PrescriptionsPage"
             Title="My Prescriptions">

    <ScrollView>
        <VerticalStackLayout Padding="20,40,20,20" Spacing="20">

            <Button Text="Back to Dashboard"
                    HeightRequest="48"
                    BackgroundColor="DimGray"
                    Clicked="BackButton_Clicked"/>

            <Label Text="My Prescriptions"
                   FontSize="24"
                   FontAttributes="Bold"/>

            <Label Text="{Binding PrescriptionStatus}" TextColor="Gray"/>

            <CollectionView ItemsSource="{Binding Prescriptions}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Margin="0,5">
                            <VerticalStackLayout>
                                <Label Text="{Binding DisplayText}"/>
                                <Label Text="{Binding DetailText}" FontSize="12" TextColor="Gray"/>
                                <Label Text="{Binding RefillText}" FontSize="12" TextColor="DarkOrange"/>
                                <Button Text="Request Refill"
                                        IsEnabled="{Binding CanRequestRefill}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PrescriptionsViewModel}}, Path=RequestRefillCommand}"
                                        CommandParameter="{Binding .}"/>
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
